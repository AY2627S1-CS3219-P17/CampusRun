# ─────────────────────────────────────────────────────────────
# CampusRun · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
# RS256 key pair for access tokens. Generate both with:  sh scripts/generate-jwt-keys.sh >> .env
# The private key only goes to user-service (and the credit-demo tool); the
# other services get the public key, which verifies tokens but can't sign them.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Seconds an access token stays valid (default 300, i.e. 5 minutes). Also the
# longest a revoked session keeps working, since services check access tokens
# on their own. Set it low (e.g. 20) to watch the web app refresh.
JWT_ACCESS_TOKEN_TTL_SECONDS=
# Seconds a sign-in lasts before the user must enter their password again
# (default 604800, i.e. 7 days). Refreshing never extends it.
JWT_REFRESH_TOKEN_TTL_SECONDS=

# ---- User service DB ----------------------------------------
# Used by compose.yaml to create the user-db container and build
# the user service's DATABASE_URL. (AI-generated, Claude Code, 2026-09-25)
USER_DB_USER=user_service
USER_DB_PASSWORD=
USER_DB_NAME=user_service
# First admin, created by the user-seed-admin service on `docker compose up`.
# Leave all three empty to skip. The email must be @u.nus.edu, and the
# username and password follow the registration rules. (AI-updated, Claude Code, 2026-09-28)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ---- Supplier service DB ------------------------------------
# Used by compose.yaml to create the supplier-db container and build
# the supplier service's DATABASE_URL. (AI-generated, Claude, 2026-09-26)
SUPPLIER_DB_USER=supplier_service
SUPPLIER_DB_PASSWORD=
SUPPLIER_DB_NAME=supplier_service

# ---- Credit service DB --------------------------------------
# Used by compose.yaml to create the credit-db container and build
# the credit service's DATABASE_URL. (AI-generated, Claude, 2026-10-17)
CREDIT_DB_USER=credit_service
CREDIT_DB_PASSWORD=
CREDIT_DB_NAME=credit_service
# Credits every new wallet starts with
INITIAL_CREDITS=100

# ---- Order service DB ---------------------------------------
# Used by compose.yaml to create the order-db container and build
# the order service's DATABASE_URL. (AI-generated, Claude Code, 2026-10-18)
ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=
ORDER_DB_NAME=order_service

# ---- Order worker sweeper (optional) ------------------------
# How often order-worker expires errands and resends stuck credit
# commands; lower them for a demo. (AI-generated, Claude Code, 2026-10-19)
# ORDER_SWEEP_SECONDS=30
# ORDER_RECONCILE_AFTER_MINUTES=5

# ---- RabbitMQ -----------------------------------------------
# One login per service, created by rabbitmq/provision.sh; what each may
# send is in rabbitmq/definitions.json. The admin login is only for the
# management UI at http://localhost:15672. (AI-generated, Claude, 2026-10-17)
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_CREDIT_SERVICE_PASSWORD=
RABBITMQ_USER_SERVICE_PASSWORD=
RABBITMQ_ORDER_SERVICE_PASSWORD=

# ---- Frontend -----------------------------------------------
# The frontend's dev-server settings (VITE_API_PROXY_TARGET) live in
# frontend/.env; see frontend/.env.example. (AI-generated, Claude Code, 2026-09-27)

# ... Add more variables as needed

# ---- Order service AI autofill -----------------------------------
# Set the real key in the ignored root .env; never put it in frontend variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
