# Scope: AI-generated example of the local-development settings.
# Tool: Claude Code (model: Claude Opus 5.5), date: 2026-11-09
# Scope: AI-replaced JWT_SECRET with JWT_PUBLIC_KEY.
# Author review: reviewed by Aaron

# Only used when running the service directly on your machine (fastapi dev, credit-worker, alembic, pytest).
# Copy to `.env` and fill in the passwords to match the root .env.
# Inside Docker Compose, these are injected by compose.yaml and override this file.
DATABASE_URL=postgresql+asyncpg://credit_service:<CREDIT_DB_PASSWORD>@127.0.0.1:5435/credit_service

# The worker's RabbitMQ login (user credit-service). The API doesn't use it.
RABBITMQ_URL=amqp://credit-service:<RABBITMQ_CREDIT_SERVICE_PASSWORD>@127.0.0.1:5672/

# The User Service's public key: the JWT_PUBLIC_KEY line from the root .env. It verifies tokens but can't sign them.
JWT_PUBLIC_KEY=

# Credits every new wallet starts with
INITIAL_CREDITS=100

# Serves the interactive API docs at /docs
ENABLE_DOCS=true

# Only for `uv run credit-demo`, which stands in for the Order Service on your machine. It signs tokens for any
# user, so it needs the JWT_PRIVATE_KEY line from the root .env too; the credit service itself never reads it.
# JWT_PRIVATE_KEY=
DEMO_RABBITMQ_URL=amqp://order-service:<RABBITMQ_ORDER_SERVICE_PASSWORD>@127.0.0.1:5672/
CREDIT_API_URL=http://127.0.0.1:8003
USER_API_URL=http://127.0.0.1:8001
