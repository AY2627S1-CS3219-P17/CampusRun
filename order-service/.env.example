# AI Assistance Disclosure:
# Tool: OpenAI Codex (GPT-6), date: 2026-10-17
# Scope: Documented direct-host order-service settings following supplier-service/.env.example.
# Tool: Claude Code (model: Claude Opus 5.5), date: 2026-10-18
# Scope: AI-added DATABASE_URL and RABBITMQ_URL for running the API, worker, Alembic and tests on the host;
#        AI-added the user and credit service URLs (2026-10-19).
# Author review: <to be completed by author>

# Only used when running this service directly on your machine (fastapi dev, order-worker, alembic).
# Copy to `.env` and fill in the values. Docker Compose injects its own values from compose.yaml.
# The tests don't use this file: they start their own throwaway Postgres container.
DATABASE_URL=postgresql+asyncpg://order_service:<ORDER_DB_PASSWORD>@127.0.0.1:5436/order_service

# The worker's RabbitMQ login (user order-service). The API doesn't use it.
RABBITMQ_URL=amqp://order-service:<RABBITMQ_ORDER_SERVICE_PASSWORD>@127.0.0.1:5672/

# Same value as JWT_SECRET in the root .env (at least 32 characters).
JWT_SECRET=

# Same Groq key used by Compose; keep it in backend .env files only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Reach the other services through the gateway when order-service runs on the host.
SUPPLIER_SERVICE_URL=http://localhost:8080/api/suppliers
CREDIT_API_URL=http://localhost:8080/api/credits
# The username lookup is internal-only (blocked at the gateway), so on the host errands show no usernames
# unless you run user-service on the host too (e.g. http://127.0.0.1:8001).
USER_SERVICE_URL=http://localhost:8080/api/users

# Serves the interactive API docs at /docs for local development.
ENABLE_DOCS=true
