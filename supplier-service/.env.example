# Only used when running the service directly on your machine (e.g. `fastapi dev`, alembic, the seed command).
# Copy to `.env` and fill in the password to match SUPPLIER_DB_PASSWORD in the root .env.
# Inside Docker Compose, these are injected by compose.yaml and override this file.
DATABASE_URL=postgresql+asyncpg://supplier_service:<password>@127.0.0.1:5434/supplier_service

# Same value as JWT_SECRET in the root .env (at least 32 characters). The User Service signs tokens with it.
JWT_SECRET=

# The web client's dev server, so the browser may call this service directly
CORS_ORIGINS=http://localhost:5173
