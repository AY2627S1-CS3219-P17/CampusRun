# AI Assistance Disclosure:
# Tool: Claude Code (model: Claude Opus 5.5), date: 2026-09-25
# Scope: AI-generated example of the local-development DATABASE_URL and ENABLE_DOCS.
# Author review: reviewed by Nathan

# Only used when running the API directly on your machine (e.g. `fastapi dev`).
# Copy to `.env` and fill in the password to match USER_DB_PASSWORD in the root .env.
# Inside Docker Compose, DATABASE_URL is injected by compose.yaml and overrides this file.
DATABASE_URL=postgresql+asyncpg://user_service:<password>@localhost:5433/user_service

JWT_SECRET=

# Serve the interactive API docs at /docs, /redoc and /openapi.json. Leave unset in deployed environments.
ENABLE_DOCS=true

# Initial admin credentials for the user service
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
